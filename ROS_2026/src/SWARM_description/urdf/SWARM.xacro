<?xml version="1.0" ?>
<robot name="SWARM" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find SWARM_description)/urdf/materials.xacro" />
<xacro:include filename="$(find SWARM_description)/urdf/SWARM.ros2control" />
<xacro:include filename="$(find SWARM_description)/urdf/SWARM.gazebo" />

<link name="base_footprint"/>

<joint name="base_footprint_joint" type="fixed">
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <parent link="base_footprint"/>
  <child link="base_link"/>
</joint>

<link name="base_link">
  <inertial>
    <origin xyz="-6.463913954572466e-07 0.0 0.061218450595844895" rpy="0 0 0"/>
    <mass value="12.43947432540084"/>
    <inertia ixx="0.2276794" iyy="0.4779003" izz="0.6581208" ixy="0.0" iyz="0.0" ixz="-4e-06"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find SWARM_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find SWARM_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="lidar_1">
  <inertial>
    <origin xyz="-2.220446049250313e-18 -1.3877787807814457e-19 0.003999999999999976" rpy="0 0 0"/>
    <mass value="0.3156672298327027"/>
    <inertia ixx="0.000128" iyy="0.000128" izz="0.000253" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.0 -0.0 -0.14" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find SWARM_description)/meshes/lidar_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.0 -0.0 -0.14" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find SWARM_description)/meshes/lidar_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="camera_1">
  <inertial>
    <origin xyz="-0.030000000000000082 -7.105427357601002e-17 0.010000000000000009" rpy="0 0 0"/>
    <mass value="0.4069439999999993"/>
    <inertia ixx="5.8e-05" iyy="0.000189" izz="0.00022" ixy="-0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.34 0.0 -0.125" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find SWARM_description)/meshes/camera_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.34 0.0 -0.125" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find SWARM_description)/meshes/camera_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="front_caster_1">
  <inertial>
    <origin xyz="-0.07 -7.105427357601002e-17 -0.0075" rpy="0 0 0"/>
    <mass value="0.1315280124302927"/>
    <inertia ixx="1.4e-05" iyy="1.4e-05" izz="2.1e-05" ixy="-0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.34 0.0 -0.0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find SWARM_description)/meshes/front_caster_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.34 0.0 -0.0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find SWARM_description)/meshes/front_caster_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="back_caster_1">
  <inertial>
    <origin xyz="0.07 5.134781488891349e-17 -0.007500000000000004" rpy="0 0 0"/>
    <mass value="0.1315280124302927"/>
    <inertia ixx="1.4e-05" iyy="1.4e-05" izz="2.1e-05" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.34 -0.0 -0.0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find SWARM_description)/meshes/back_caster_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0.34 -0.0 -0.0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find SWARM_description)/meshes/back_caster_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="left_wheel_1">
  <inertial>
    <origin xyz="-8.076544029899345e-08 0.020000000000000018 1.380766763044161e-07" rpy="0 0 0"/>
    <mass value="1.5783361491635122"/>
    <inertia ixx="0.000842" iyy="0.001263" izz="0.000842" ixy="0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.000252 -0.12 -0.02008" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find SWARM_description)/meshes/left_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.000252 -0.12 -0.02008" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find SWARM_description)/meshes/left_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="right_wheel_1">
  <inertial>
    <origin xyz="-8.076544036334085e-08 -0.01999999999999999 1.3807667632176335e-07" rpy="0 0 0"/>
    <mass value="1.578336149163511"/>
    <inertia ixx="0.000842" iyy="0.001263" izz="0.000842" ixy="0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.000252 0.12 -0.02008" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find SWARM_description)/meshes/right_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.000252 0.12 -0.02008" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find SWARM_description)/meshes/right_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="lidar_joint" type="fixed">
  <origin xyz="0.0 0.0 0.14" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="lidar_1"/>
</joint>

<joint name="camera_joint" type="fixed">
  <origin xyz="0.34 0.0 0.12" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="camera_1"/>
</joint>

<joint name="front_caster_joint" type="fixed">
  <origin xyz="0.34 0.0 0.01" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="front_caster_1"/>
</joint>

<joint name="back_caster_joint" type="fixed">
  <origin xyz="-0.34 0.0 0.01" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="back_caster_1"/>
</joint>

<joint name="left_wheel_joint" type="continuous">
  <origin xyz="0.000252 0.12 0.02008" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="left_wheel_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="right_wheel_joint" type="continuous">
  <origin xyz="0.000252 -0.12 0.02008" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="right_wheel_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<gazebo reference="front_caster_1">
  <mu1>0.0</mu1>
  <mu2>0.0</mu2>
</gazebo>

<gazebo reference="back_caster_1">
  <mu1>0.0</mu1>
  <mu2>0.0</mu2>
</gazebo>

<gazebo reference="lidar_1">
  <sensor name="gpu_lidar" type="gpu_lidar">
    <pose>0 0 0 0 0 0</pose>
    <topic>scan</topic>
    <gz_frame_id>lidar_1</gz_frame_id>
    <always_on>1</always_on>
    <update_rate>10</update_rate>
    <visualize>true</visualize>
    <ray>
      <scan>
        <horizontal>
          <samples>640</samples>
          <resolution>1</resolution>
          <min_angle>-3.1415926</min_angle>
          <max_angle>3.1415926</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.08</min>
        <max>12.0</max>
        <resolution>0.01</resolution>
      </range>
    </ray>
  </sensor>
</gazebo>

<gazebo>
  <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
    <left_joint>left_wheel_joint</left_joint>
    <right_joint>right_wheel_joint</right_joint>
    <wheel_separation>0.28</wheel_separation>
    <wheel_radius>0.0399</wheel_radius>
    <max_linear_acceleration>100.0</max_linear_acceleration>
    <max_angular_acceleration>100.0</max_angular_acceleration>
    <topic>cmd_vel</topic>
    <odom_topic>odom</odom_topic>
    <tf_topic>/tf</tf_topic> 
    <frame_id>odom</frame_id>
    <child_frame_id>base_footprint</child_frame_id>
    <publish_odom>true</publish_odom>
    <publish_odom_tf>true</publish_odom_tf>
  </plugin>
</gazebo>

<gazebo>
  <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
    <topic>joint_states</topic>
    <update_rate>30</update_rate>
  </plugin>
</gazebo>

<gazebo>
  <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
    <publish_link_pose>true</publish_link_pose>
    <publish_sensor_pose>true</publish_sensor_pose>
    <publish_collision_pose>false</publish_collision_pose>
    <publish_visual_pose>false</publish_visual_pose>
    <publish_nested_models>true</publish_nested_models>
    <use_pose_vector_msg>true</use_pose_vector_msg>
    <static_publisher>true</static_publisher>
    <static_update_frequency>10</static_update_frequency>
  </plugin>
</gazebo>

</robot>